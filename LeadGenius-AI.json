    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "outputs = []\n\nfor item in _items:\n    data = item.get(\"json\", {})\n    \n    try:\n        print(\"Input JSON:\", json.dumps(data, indent=2))\n    except Exception as e:\n        print(\"Debug JSON Error:\", str(e)[:100])\n    \n    url = (\n        str(data.get(\"URL\") or \"\").strip().lower() or\n        str(data.get(\"WebURL\") or \"\").strip().lower() or\n        str(data.get(\"website\") or \"\").strip().lower() or\n        str(data.get(\"Website\") or \"\").strip().lower() or\n        str(data.get(\"url\") or \"\").strip().lower() or\n        str(data.get(\"URLs\") or \"\").strip().lower()\n    )\n    domain = (\n        str(data.get(\"Domain\") or \"\").strip().lower() or\n        str(data.get(\"domain\") or \"\").strip().lower() or\n        url\n    )\n    email = (\n        str(data.get(\"email\") or \"\").strip().lower() or\n        str(data.get(\"Email\") or \"\").strip().lower()\n    )\n    name = str(data.get(\"Name\") or \"This company\").strip()\n    summary = \"\"\n    error = \"\"\n\n    possible_urls = []\n    if url:\n        possible_urls = [u.strip() for u in url.split(\",\") if u.strip()]\n    if not possible_urls and domain:\n        possible_urls = [domain]\n\n    if not domain:\n        if email and '@' in email:\n            domain = email.split('@')[-1].strip()\n        elif possible_urls:\n            parsed = urlparse(possible_urls[0] if possible_urls[0].startswith('http') else f\"https://{possible_urls[0]}\")\n            domain = parsed.hostname.replace('www.', '').strip() if parsed.hostname else \"\"\n        if not domain:\n            summary = f\"{name} appears to be a business, but no website content was accessible.\"\n            error = \"No domain, email, or URL found to extract from.\"\n            data[\"Summary\"] = summary\n            data[\"Error\"] = error\n            data[\"URL\"] = \"\"\n            outputs.append({\"json\": data})\n            continue\n\n    data[\"Domain\"] = domain\n    selected_url = possible_urls[0] if possible_urls else f\"https://{domain}\"\n\n    website_content = data.get(\"websiteContent\", \"\")\n    error = data.get(\"error\", \"\")\n\n    try:\n        if website_content and not error:\n            soup = BeautifulSoup(website_content, \"html.parser\")\n            text = \" \".join(soup.stripped_strings)\n            text = \" \".join(text.split())[:4000]\n            if len(text) >= 50:\n                sentences = text.split(\".\")\n                summary = \". \".join(sentences[:3]).strip() + \".\"\n                if len(summary) < 40:\n                    summary = f\"{name} offers services in digital marketing, SEO, or technology.\"\n            else:\n                error = error or \"Website content too short\"\n                summary = f\"{name} offers services, but the website lacks sufficient content.\"\n        else:\n            error = error or \"No website content provided by HTTP Request\"\n            summary = f\"{name} website could not be reached or lacks sufficient content.\"\n    except Exception as e:\n        error = error or f\"Error processing content: {str(e)[:100]}\"\n        summary = f\"{name} website could not be reached or lacks sufficient content.\"\n\n    data[\"URL\"] = selected_url\n    data[\"Summary\"] = summary\n    data[\"Error\"] = error\n    outputs.append({\"json\": data})\n\nreturn outputs"
      },
