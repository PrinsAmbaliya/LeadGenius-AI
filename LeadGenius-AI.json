    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "outputs = []\n\ndef clean_domain(url):\n    \"\"\"Extract valid domain (e.g., example.com) from a URL string.\"\"\"\n    if not url:\n        return \"\"\n    url = str(url).strip().lower()\n    url = url.replace(\"http://\", \"\").replace(\"https://\", \"\").replace(\"www.\", \"\")\n    domain = url.split(\"/\")[0].split(\"?\")[0]\n    parts = domain.split(\".\")\n    if len(parts) >= 2 and all(parts):\n        tld = parts[-1]\n        if len(tld) >= 2 and tld.isalpha():\n            return domain\n    return \"\"\n\nfor item in _items:\n    data = item.get(\"json\", {})\n    \n    email = data.get(\"Email\", \"\")\n    weburl = data.get(\"WebURL\", \"\")\n    domain = data.get(\"Domain\", \"\")\n\n    extracted_domains = []\n\n    # Step 1: Existing domain\n    if domain:\n        d = clean_domain(domain)\n        if d:\n            extracted_domains.append(d)\n\n    # Step 2: From email\n    if email and \"@\" in email:\n        d = clean_domain(email.split(\"@\")[-1])\n        if d and d not in extracted_domains:\n            extracted_domains.append(d)\n\n    # Step 3: From WebURL(s)\n    if weburl:\n        urls = [u.strip() for u in str(weburl).split(\",\") if u.strip()]\n        for u in urls:\n            d = clean_domain(u)\n            if d and d not in extracted_domains:\n                extracted_domains.append(d)\n\n    # Step 4: If nothing valid → mark as error\n    if not extracted_domains:\n        data[\"Error\"] = \"No valid domain found\"\n        data[\"Domain\"] = \"\"\n        data[\"URL\"] = None\n        outputs.append({\"json\": data})\n        continue\n\n    # Step 5: Valid domain → ready for HTTP Request\n    for d in extracted_domains:\n        new_row = dict(data)\n        new_row[\"Domain\"] = d\n        new_row[\"URL\"] = f\"https://{d}\"\n        new_row[\"Error\"] = \"\"\n        outputs.append({\"json\": new_row})\n\nreturn outputs\n"
      },
